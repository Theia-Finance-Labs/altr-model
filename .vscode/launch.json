{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Kedro Run AltRisk with reporting (Debug)",
        "type": "debugpy",
        "request": "launch",
        "module": "kedro",
        "args": [
          "run",
          "--tags=altrisk,reporting"
        ],
        "console": "integratedTerminal",
        "justMyCode": false,
        "env": {
          "PYTHONBREAKPOINT": "ipdb.set_trace"
        }
      },
      {
        "name": "Kedro Run AltRisk (Debug)",
        "type": "debugpy",
        "request": "launch",
        "module": "kedro",
        "args": [
          "run",
          "--tags=altrisk"
        ],
        "console": "integratedTerminal",
        "justMyCode": false,
        "env": {
          "PYTHONBREAKPOINT": "ipdb.set_trace"
        }
      },
      {
        "name": "Download BigQuery Input Data (Debug)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/src/altr_model/bigquery_marts_downloader.py",
        "console": "integratedTerminal",
        "justMyCode": false,
        "env": {
          "PYTHONBREAKPOINT": "ipdb.set_trace"
        }
      }
    ]
  }