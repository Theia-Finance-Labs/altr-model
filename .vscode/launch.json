{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Kedro Run AltRisk (Debug)",
        "type": "debugpy",
        "request": "launch",
        "module": "kedro",
        "args": [
          "run",
          "--tags=altrisk"
        ],
        "console": "integratedTerminal",
